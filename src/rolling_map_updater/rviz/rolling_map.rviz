Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
      Splitter Ratio: 0.5
    Tree Height: 549
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Reference Frame: map
      Cell Size: 1
      Plane Cell Count: 40
      Color: 120; 120; 120
      Alpha: 0.4
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Show Names: true
      Show Axes: true
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Name: RollingPose
      Topic:
        Value: /rolling_pose
      Keep: 100
      Shape:
        Value: Arrow
        Color: 0; 220; 255
        Shaft Length: 0.5
        Head Length: 0.2
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: PriorMap_ReadOnly_Gray
      Topic:
        Value: /rolling_map/prior_map
      Style: Points
      Size (m): 0.025
      Color Transformer: FlatColor
      Color: 135; 135; 140
      Alpha: 0.18
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: RollingSubmap_GrayPrior_BlueNew
      Topic:
        Value: /rolling_map/active_submap
      Style: Points
      Size (m): 0.035
      Color Transformer: RGB8
      Alpha: 0.45
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: NewInLive_NotInPrior_Blue
      Topic:
        Value: /rolling_map/new_points
      Style: Points
      Size (m): 0.05
      Color Transformer: FlatColor
      Color: 20; 145; 255
      Alpha: 1.0
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: RemovedOld_MissingInLive_Red
      Topic:
        Value: /rolling_map/removed_points
      Style: Points
      Size (m): 0.05
      Color Transformer: FlatColor
      Color: 255; 40; 40
      Alpha: 1.0
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: LiveScan_MatchGreen_FailRed
      Topic:
        Value: /rolling_map/aligned_scan
      Style: Points
      Size (m): 0.028
      Color Transformer: RGB8
      Alpha: 0.90
  Global Options:
    Background Color: 25; 25; 25
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 16.0
      Pitch: 0.75
      Yaw: 0.75
      Focal Point:
        X: 0
        Y: 0
        Z: 0
